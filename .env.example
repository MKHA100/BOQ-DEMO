APP_MODE=local
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=false
ALLOW_LOCAL_AUTH_BYPASS=true
SUPER_ADMIN_EMAIL=admin@construction.local
SUPER_ADMIN_PASSWORD=ChangeMe12345
LOCAL_DATABASE_PATH=storage_data/app.db
LOCAL_STORAGE_ROOT=storage_data
MAX_UPLOAD_MB=200
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_LEASE_SECONDS=90

# Optional structured schedule/specification extraction
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_EXTRACTION_TIMEOUT_SECONDS=90
OPENAI_EXTRACTION_MAX_PAGES=12

# Production only
DATABASE_URL=
DIRECT_DATABASE_URL=
STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional model detection
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=cubicasa5k-2-qpmsa/6
ROBOFLOW_API_BASE_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT_SECONDS=90

# Optional hybrid room segmentation (uses the same private Roboflow key)
ROBOFLOW_FLOOR_ENABLED=true
ROBOFLOW_FLOOR_MODEL_ID=room-segmentation-o7iga/4
ROBOFLOW_FLOOR_CONFIDENCE=0.45
ROBOFLOW_FLOOR_TIMEOUT_SECONDS=90

SQLITE_BUSY_TIMEOUT_SECONDS=30

# Unified multi-class floor detection
MODEL_DETECTION_MAX_CONCURRENCY=2
ROBOFLOW_DOOR_CONFIDENCE=0.35
ROBOFLOW_WINDOW_CONFIDENCE=0.35
ROBOFLOW_WALL_CONFIDENCE=0.30
ROBOFLOW_DEEP_ANALYSIS_ENABLED=true
ROBOFLOW_DEEP_ANALYSIS_TILE_OVERLAP=0.15

# Precision room geometry and editor
ROOM_FAST_PASS_ENABLED=true
ROOM_PRECISION_PASS_ENABLED=true
ROOM_PRECISION_MAX_CONCURRENCY=1
ROOM_MIN_EDGE_PIXELS=4
ROOM_COLLINEAR_TOLERANCE_DEGREES=3
ROOM_ORTHOGONAL_TOLERANCE_DEGREES=5
ROOM_RECTANGLE_CONFIDENCE=0.90
ROOM_DIMENSION_WARNING_PERCENT=2
ROOM_DIMENSION_ERROR_PERCENT=5
ROOM_LLM_ENABLED=true
ROOM_LLM_ONLY_WHEN_AMBIGUOUS=false
ROOM_LLM_BACKGROUND_ENABLED=true
ROOM_LLM_MODEL=gpt-5.5
ROOM_LLM_TIMEOUT_SECONDS=60
ROOM_LLM_MAX_FLOOR_CALLS=1
ROOM_LLM_MAX_ROOM_CROPS=4
ROOM_LLM_CONFIDENCE_THRESHOLD=0.65
ROOM_RESULTS_PUBLISH_EARLY=true
ROOM_EXCEPTION_CORRECTION_ENABLED=true
ROOM_EXCEPTION_MIN_LABEL_CONFIDENCE=0.72
# Enable when floor-plan room labels are rasterized/outlined rather than PDF text.
ROOM_EXCEPTION_FULL_FLOOR_OCR_ENABLED=false
ROOM_EXCEPTION_OCR_MAX_DIMENSION=3000

# Automatic wall recovery (fast full image first, enhanced tiles in background)
WALL_AUTO_RECOVERY_ENABLED=true
WALL_RECOVERY_TILE_PIXELS=1024
WALL_RECOVERY_TILE_OVERLAP=0.25
WALL_RECOVERY_MAX_TILES=9
WALL_RECOVERY_CONCURRENCY=4
WALL_RECOVERY_MIN_CONFIDENCE=0.50
WALL_VECTOR_RECOVERY_ENABLED=false
WALL_RECOVERY_MIN_LENGTH=10
WALL_RECOVERY_MIN_ASPECT_RATIO=2.8
WALL_RECOVERY_MIN_THICKNESS_RATIO=0.45
WALL_RECOVERY_MAX_THICKNESS_RATIO=2.2
WALL_RECOVERY_MAX_GAP=14
WALL_RECOVERY_GAP_THICKNESS_FACTOR=1.8
WALL_RECOVERY_REPEATED_LINE_LIMIT=4
WALL_RECOVERY_BORDER_TOLERANCE=1.5
DOOR_RECOVERY_MIN_CONFIDENCE=0.45
WINDOW_RECOVERY_MIN_CONFIDENCE=0.45
OPENING_RECOVERY_MIN_SIZE=4
OPENING_RECOVERY_MAX_ASPECT_RATIO=10
OPENING_RECOVERY_WALL_DISTANCE=12
OPENING_RECOVERY_WALL_DISTANCE_FACTOR=0.65
OPENING_RECOVERY_INDEPENDENT_CONFIDENCE=0.72
OPENING_RECOVERY_BORDER_CONFIDENCE=0.82
