{
  "name": "autoboq",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && PYTHONPATH=. .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "backend:test": "cd backend && PYTHONPATH=. pytest",
    "backend:worker": "cd backend && PYTHONPATH=. python -m app.jobs.worker"
  }
}
